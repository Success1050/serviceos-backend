generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// PLATFORM & MULTI-TENANCY
// ------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique // For tenant portal: serviceos.com/s/[slug]
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Hierarchy (V2)
  parentId String?
  parent   Tenant?  @relation("TenantHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Tenant[] @relation("TenantHierarchy")

  // Relationships
  users                 User[]
  departments           Department[]
  customerRelationships CustomerTenantRelationship[]
  customerRecords       CustomerRecord[]
  quotes                Quote[]
  invoices              Invoice[]
  jobs                  Job[]
  serviceRequests       ServiceRequest[]
  assets                Asset[]
  maintenanceSchedules  MaintenanceSchedule[]
  notifications         Notification[]
  announcements         Announcement[]
  internalTickets       InternalTicket[]
  roles                 Role[]
  productCatalogs       ProductCatalog[]
  warehouses            Warehouse[]
  equipmentRequests     EquipmentRequest[]
  expenseReceipts       ExpenseReceipt[]
  escrowHolds           EscrowHold[]
  quoteMilestones       QuoteMilestone[]
  paymentTransactions   PaymentTransaction[]

  settings  TenantSettings?
  auditLogs AuditLog[]
}

enum AnnouncementPriority {
  LOW
  NORMAL
  URGENT
}

enum InternalTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Announcement {
  id            String               @id @default(uuid())
  tenantId      String // HQ Tenant
  title         String
  content       String
  priority      AnnouncementPriority @default(NORMAL)
  targetTenants String[] // If empty, global. If populated, only these Tenant IDs see it.

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InternalTicket {
  id          String               @id @default(uuid())
  tenantId    String // Sub-Company Tenant
  authorId    String
  title       String
  description String
  status      InternalTicketStatus @default(OPEN)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Config domains as JSON to allow flexible schemas
  businessProfile Json? // Company Name, Address, Currency, Tax
  branding        Json? // Logos, Colors
  portal          Json? // Enabled features, welcome message
  quotes          Json?
  invoices        Json?
  payments        Json?
  notifications   Json?
  scheduling      Json?
  technicians     Json?
  lockedSettings  Json? // Fields that HQ forces onto sub-companies (e.g. ['branding', 'businessProfile'])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// STAFF / USERS (RBAC)
// ------------------------------------------------------

model Department {
  id       String @id @default(uuid())
  tenantId String
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  isGlobal    Boolean  @default(false)
  permissions String[]
  tenantId    String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  phone        String?
  firstName    String
  lastName     String

  status                UserStatus  @default(ACTIVE)
  requiresPasswordReset Boolean     @default(false)
  departmentId          String?
  department            Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  tenantId String? // Nullable because Platform Admin might not belong to a tenant
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roleId            String?
  role              Role?    @relation(fields: [roleId], references: [id])
  directPermissions String[] // Direct user-level permissions overriding/adding to Role

  assignedJobs    Job[]
  notifications   Notification[]
  internalTickets InternalTicket[]
  virtualTruck    Warehouse?

  lastKnownLatitude  Float?
  lastKnownLongitude Float?
  lastLocationUpdate DateTime?
  avatarUrl          String?
  bio                String?
  certifications     String[]    @default([])
  rating             Float?      @default(5.0)
  jobsCompletedCount Int         @default(0)
  expenseReceipts    ExpenseReceipt[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]
}

// ------------------------------------------------------
// CUSTOMER IDENTITY & RELATIONSHIPS
// ------------------------------------------------------

// 1. ServiceOS Customer Identity (The authenticated person using ServiceOS)
model ServiceOSIdentity {
  id     String         @id @default(uuid())
  phone  String?        @unique
  email  String?        @unique
  status IdentityStatus @default(PENDING) // PENDING | ACTIVE | SUSPENDED | LOCKED

  // They can belong to multiple tenants
  tenantRelationships CustomerTenantRelationship[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum IdentityStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
}

// 2. Customer Record (Business's customer info)
model CustomerRecord {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Business data
  name    String
  email   String?
  phone   String?
  address String?
  city    String?

  relationships        CustomerTenantRelationship[]
  quotes               Quote[]
  jobs                 Job[]
  invoices             Invoice[]
  assets               Asset[]
  serviceRequests      ServiceRequest[]
  maintenanceSchedules MaintenanceSchedule[]
  escrowHolds          EscrowHold[]
  paymentTransactions  PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// 3. Customer-Tenant Relationship (Links Identity, Tenant, and Customer Record)
model CustomerTenantRelationship {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  identityId String? // Can be null if identity is not yet established (invitation pending)
  identity   ServiceOSIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  status PortalStatus @default(NOT_ACTIVATED)

  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, customerRecordId])
}

enum PortalStatus {
  NOT_ACTIVATED
  INVITATION_PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

// ------------------------------------------------------
// INVITATIONS
// ------------------------------------------------------

model Invitation {
  id             String                     @id @default(uuid())
  tokenHash      String                     @unique // Secure hash
  relationshipId String
  relationship   CustomerTenantRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  status    InvitationStatus @default(PENDING)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InvitationStatus {
  PENDING
  DELIVERED
  OPENED
  EXPIRED
  ACCEPTED
  REVOKED
}

// ------------------------------------------------------
// BUSINESS ENTITIES (STUBS FOR MODULES)
// ------------------------------------------------------

model Asset {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String
  manufacturer String?
  modelNumber  String?
  serialNumber String?
  installDate  DateTime?
  status       AssetStatus @default(ACTIVE)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  warrantyExpiresAt   DateTime?
  warrantyDocumentUrl String?

  serviceRequests      ServiceRequest[]
  maintenanceSchedules MaintenanceSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Quote {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  title  String
  amount Decimal
  status QuoteStatus @default(DRAFT)
  billingType         BillingType @default(FIXED)
  termsAndConditions  String?
  signedTermsAt       DateTime?
  signerName          String?
  signerIp            String?
  signatureData       String?

  milestones QuoteMilestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([tenantId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Invoice {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title  String
  amount Decimal
  status InvoiceStatus @default(DRAFT)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  escrowHold          EscrowHold?
  quoteMilestone      QuoteMilestone?
  paymentTransactions PaymentTransaction[]

  dueDate DateTime?
  paidAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Job {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      JobStatus @default(SCHEDULED)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  assignedTechnicianId String?
  assignedTechnician   User?   @relation(fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  scheduledAt            DateTime?
  estimatedDuration      Int       @default(60)
  enRouteAt              DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  completionOtp          String?
  completionOtpExpiresAt DateTime?
  paymentHoldStatus      String? // HOLD_PENDING, HELD, HOLD_FAILED, CAPTURED
  escrowHolds            EscrowHold[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices        Invoice[]
  serviceRequests ServiceRequest[]
  expenseReceipts ExpenseReceipt[]

  @@index([tenantId])
}

enum JobStatus {
  SCHEDULED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ServiceRequest {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  description String
  status      ServiceRequestStatus @default(OPEN)
  urgency     UrgencyLevel         @default(NORMAL)
  preferredDate DateTime?
  preferredTimeSlot String?
  attachments String[]             @default([])

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum ServiceRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum UrgencyLevel {
  LOW
  NORMAL
  URGENT
  EMERGENCY
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model MaintenanceSchedule {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title          String
  intervalMonths Int
  nextDueDate    DateTime
  status         ScheduleStatus @default(ACTIVE)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  currentJobId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([nextDueDate])
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Notification {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    String  @default("INFO")
  isRead  Boolean @default(false)
  linkUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId])
}

// ------------------------------------------------------
// AUDIT LOG
// ------------------------------------------------------

model AuditLog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String // e.g., "UPDATE_SETTINGS", "DELETE_QUOTE"
  entityType String // e.g., "TenantSettings", "Quote"
  entityId   String? // ID of the affected record
  details    Json? // Stores what changed (before/after)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// ------------------------------------------------------
// STAGE 23: INVENTORY & EXPENSES
// ------------------------------------------------------

model ProductCatalog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name  String
  sku   String?
  price Decimal?

  inventoryItems    InventoryItem[]
  equipmentRequests EquipmentRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum WarehouseType {
  HQ_WAREHOUSE
  VIRTUAL_TRUCK
}

model Warehouse {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  type WarehouseType @default(HQ_WAREHOUSE)

  assignedTechnicianId String? @unique
  assignedTechnician   User?   @relation(fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  inventoryItems    InventoryItem[]
  equipmentRequests EquipmentRequest[] // Requests sent to this warehouse

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model InventoryItem {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  productId String
  product   ProductCatalog @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productId])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

model EquipmentRequest {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  hqWarehouseId String
  hqWarehouse   Warehouse @relation(fields: [hqWarehouseId], references: [id], onDelete: Cascade)

  productId String
  product   ProductCatalog @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int

  status RequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum ExpenseStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model ExpenseReceipt {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  technicianId String
  technician   User   @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  amount          Decimal
  receiptPhotoUrl String

  status ExpenseStatus @default(PENDING_APPROVAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ------------------------------------------------------
// STAGE 24: ENTERPRISE PAYMENTS, FINANCIAL ESCROW & MILESTONES
// ------------------------------------------------------

enum BillingType {
  FIXED
  AUTH_AND_CAPTURE
  MILESTONE
}

enum PaymentGatewayType {
  STRIPE
  PAYSTACK
  FLUTTERWAVE
}

enum EscrowHoldStatus {
  HELD
  CAPTURED
  RELEASED
  FAILED
}

enum MilestoneStatus {
  PENDING
  INVOICED
  PAID
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

model QuoteMilestone {
  id       String @id @default(uuid())
  quoteId  String
  quote    Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title      String
  percentage Decimal
  amount     Decimal
  order      Int             @default(1)
  status     MilestoneStatus @default(PENDING)
  dueDate    DateTime?

  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([quoteId])
}

model EscrowHold {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  gateway        PaymentGatewayType @default(STRIPE)
  gatewayAuthId  String? // Stripe PaymentIntent ID or Paystack authorization token
  amount         Decimal
  currency       String             @default("USD")
  status         EscrowHoldStatus   @default(HELD)

  expiresAt      DateTime?
  capturedAt     DateTime?
  releasedAt     DateTime?
  failureReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([jobId])
  @@index([customerRecordId])
}

model PaymentTransaction {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerRecordId String?
  customerRecord   CustomerRecord? @relation(fields: [customerRecordId], references: [id], onDelete: SetNull)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  gateway              PaymentGatewayType
  transactionReference String             @unique
  gatewayReference     String?
  amount               Decimal
  currency             String             @default("USD")
  type                 String // "HOLD", "CAPTURE", "DIRECT_CHARGE", "MILESTONE_CHARGE", "REFUND"
  paymentMethod        String? // "CARD", "BANK_TRANSFER", "USSD"
  status               PaymentTransactionStatus @default(PENDING)
  metadata             Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([transactionReference])
}
