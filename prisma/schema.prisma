generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// PLATFORM & MULTI-TENANCY
// ------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique // For tenant portal: serviceos.com/s/[slug]
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Hierarchy (V2)
  parentId String?
  parent   Tenant?  @relation("TenantHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Tenant[] @relation("TenantHierarchy")

  // Relationships
  users                 User[]
  departments           Department[]
  customerRelationships CustomerTenantRelationship[]
  customerRecords       CustomerRecord[]
  quotes                Quote[]
  invoices              Invoice[]
  jobs                  Job[]
  serviceRequests       ServiceRequest[]
  assets                Asset[]
  maintenanceSchedules  MaintenanceSchedule[]
  notifications         Notification[]
  announcements         Announcement[]
  internalTickets       InternalTicket[]
  roles                 Role[]
  productCatalogs       ProductCatalog[]
  warehouses            Warehouse[]
  equipmentRequests     EquipmentRequest[]
  expenseReceipts       ExpenseReceipt[]
  escrowHolds           EscrowHold[]
  quoteMilestones       QuoteMilestone[]
  paymentTransactions   PaymentTransaction[]
  supportTickets        SupportTicket[]
  hrDocuments           HrDocument[]
  wallets               Wallet[]
  payoutRequests        PayoutRequest[]
  staffBankDetails      StaffBankDetail[]

  settings  TenantSettings?
  auditLogs AuditLog[]
}

enum AnnouncementPriority {
  LOW
  NORMAL
  URGENT
}

enum InternalTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Announcement {
  id            String               @id @default(uuid())
  tenantId      String // HQ Tenant
  title         String
  content       String
  priority      AnnouncementPriority @default(NORMAL)
  targetTenants String[] // If empty, global. If populated, only these Tenant IDs see it.

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InternalTicket {
  id          String               @id @default(uuid())
  tenantId    String // Sub-Company Tenant
  authorId    String
  title       String
  description String
  status      InternalTicketStatus @default(OPEN)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Config domains as JSON to allow flexible schemas
  businessProfile Json? // Company Name, Address, Currency, Tax
  branding        Json? // Logos, Colors
  portal          Json? // Enabled features, welcome message
  quotes          Json?
  invoices        Json?
  payments        Json?
  notifications   Json?
  scheduling      Json?
  technicians     Json?
  lockedSettings  Json? // Fields that HQ forces onto sub-companies (e.g. ['branding', 'businessProfile'])

  // Stage 28: Franchise Royalties
  franchiseRoyaltyRate Decimal? @db.Decimal(5, 2) // e.g. 5.00 for 5%
  royaltyType          String?  @default("PERCENTAGE") // PERCENTAGE or FLAT

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// STAFF / USERS (RBAC)
// ------------------------------------------------------

model Department {
  id       String @id @default(uuid())
  tenantId String
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  isGlobal    Boolean  @default(false)
  permissions String[]
  tenantId    String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  phone        String?
  firstName    String
  lastName     String

  status                UserStatus  @default(ACTIVE)
  requiresPasswordReset Boolean     @default(false)
  departmentId          String?
  department            Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  tenantId String? // Nullable because Platform Admin might not belong to a tenant
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roleId            String?
  role              Role?    @relation(fields: [roleId], references: [id])
  directPermissions String[] // Direct user-level permissions overriding/adding to Role

  assignedJobs    Job[]
  notifications   Notification[]
  internalTickets InternalTicket[]
  virtualTruck    Warehouse?

  lastKnownLatitude  Float?
  lastKnownLongitude Float?
  lastLocationUpdate DateTime?
  avatarUrl          String?
  bio                String?
  certifications     String[]    @default([])
  rating             Float?      @default(5.0)
  jobsCompletedCount Int                    @default(0)
  expenseReceipts    ExpenseReceipt[]
  assignedTickets    SupportTicket[]        @relation("TicketAssignee")
  resolvedTickets    SupportTicket[]        @relation("TicketResolver")
  ticketMessages     SupportTicketMessage[]

  // Stage 27: Blue-Collar HR & Field Tech Attributes
  isFieldTech                 Boolean                 @default(false)
  tradeSpecialty              String?
  customCommissionRate        Decimal?                @db.Decimal(5, 2)
  hourlyRate                  Decimal?                @db.Decimal(10, 2)

  proxyVerificationStatus     ProxyVerificationStatus @default(NOT_REQUIRED)
  managerEndorsementNotes     String?                 @db.Text
  managerVerifiedAt           DateTime?
  managerVerifiedById         String?
  managerVerifiedBy           User?                   @relation("ManagerEndorsements", fields: [managerVerifiedById], references: [id], onDelete: SetNull)
  endorsedTechs               User[]                  @relation("ManagerEndorsements")

  hqReviewNotes               String?                 @db.Text
  hqReviewedAt                DateTime?
  hqReviewedById              String?
  hqReviewedBy                User?                   @relation("HqTechReviews", fields: [hqReviewedById], references: [id], onDelete: SetNull)
  reviewedTechs               User[]                  @relation("HqTechReviews")

  termsAcknowledged           Boolean                 @default(false)
  termsAcknowledgedAt         DateTime?
  termsAcknowledgedIp         String?
  termsAcknowledgedUserAgent  String?
  termsVersion                String?                 @default("v1.0-2026")
  agreedCommissionSnapshot    Decimal?                @db.Decimal(5, 2)

  hrDocuments                 HrDocument[]            @relation("TechnicianHrFiles")
  uploadedHrDocuments         HrDocument[]            @relation("UploadedHrDocuments")
  verifiedHrDocuments         HrDocument[]            @relation("VerifiedHrDocuments")

  // Stage 28: Fintech Wallets & Payouts
  wallet                      Wallet?
  payoutRequests              PayoutRequest[]         @relation("UserPayoutRequests")
  reviewedPayouts             PayoutRequest[]         @relation("ReviewedPayouts")
  bankDetails                 StaffBankDetail[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]

  @@index([tenantId, isFieldTech])
  @@index([phone])
}

// ------------------------------------------------------
// CUSTOMER IDENTITY & RELATIONSHIPS
// ------------------------------------------------------

// 1. ServiceOS Customer Identity (The authenticated person using ServiceOS)
model ServiceOSIdentity {
  id     String         @id @default(uuid())
  phone  String?        @unique
  email  String?        @unique
  status IdentityStatus @default(PENDING) // PENDING | ACTIVE | SUSPENDED | LOCKED

  // They can belong to multiple tenants
  tenantRelationships CustomerTenantRelationship[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum IdentityStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
}

// 2. Customer Record (Business's customer info)
model CustomerRecord {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Business data
  name    String
  email   String?
  phone   String?
  address String?
  city    String?

  relationships        CustomerTenantRelationship[]
  quotes               Quote[]
  jobs                 Job[]
  invoices             Invoice[]
  assets               Asset[]
  serviceRequests      ServiceRequest[]
  maintenanceSchedules MaintenanceSchedule[]
  escrowHolds          EscrowHold[]
  paymentTransactions  PaymentTransaction[]
  supportTickets       SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// 3. Customer-Tenant Relationship (Links Identity, Tenant, and Customer Record)
model CustomerTenantRelationship {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  identityId String? // Can be null if identity is not yet established (invitation pending)
  identity   ServiceOSIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  status PortalStatus @default(NOT_ACTIVATED)

  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, customerRecordId])
}

enum PortalStatus {
  NOT_ACTIVATED
  INVITATION_PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

// ------------------------------------------------------
// INVITATIONS
// ------------------------------------------------------

model Invitation {
  id             String                     @id @default(uuid())
  tokenHash      String                     @unique // Secure hash
  relationshipId String
  relationship   CustomerTenantRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  status    InvitationStatus @default(PENDING)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InvitationStatus {
  PENDING
  DELIVERED
  OPENED
  EXPIRED
  ACCEPTED
  REVOKED
}

// ------------------------------------------------------
// BUSINESS ENTITIES (STUBS FOR MODULES)
// ------------------------------------------------------

model Asset {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String
  manufacturer String?
  modelNumber  String?
  serialNumber String?
  installDate  DateTime?
  status       AssetStatus @default(ACTIVE)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  warrantyExpiresAt   DateTime?
  warrantyDocumentUrl String?

  serviceRequests      ServiceRequest[]
  maintenanceSchedules MaintenanceSchedule[]
  supportTickets       SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Quote {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  title  String
  amount Decimal
  status QuoteStatus @default(DRAFT)
  billingType         BillingType @default(FIXED)
  termsAndConditions  String?
  signedTermsAt       DateTime?
  signerName          String?
  signerIp            String?
  signatureData       String?

  milestones QuoteMilestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([tenantId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Invoice {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title  String
  amount Decimal
  status InvoiceStatus @default(DRAFT)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  escrowHold          EscrowHold?
  quoteMilestone      QuoteMilestone?
  paymentTransactions PaymentTransaction[]
  supportTickets      SupportTicket[]
  walletTransactions  WalletTransaction[]

  dueDate DateTime?
  paidAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
}

model Job {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      JobStatus @default(SCHEDULED)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  assignedTechnicianId String?
  assignedTechnician   User?   @relation(fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  scheduledAt            DateTime?
  estimatedDuration      Int       @default(60)
  enRouteAt              DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  completionOtp          String?
  completionOtpExpiresAt DateTime?
  paymentHoldStatus      String? // HOLD_PENDING, HELD, HOLD_FAILED, CAPTURED
  escrowHolds            EscrowHold[]
  splitSettled           Boolean      @default(false)
  splitSettledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices           Invoice[]
  serviceRequests    ServiceRequest[]
  expenseReceipts    ExpenseReceipt[]
  supportTickets     SupportTicket[]
  walletTransactions WalletTransaction[]

  @@index([tenantId])
}

enum JobStatus {
  SCHEDULED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ServiceRequest {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  description String
  status      ServiceRequestStatus @default(OPEN)
  urgency     UrgencyLevel         @default(NORMAL)
  preferredDate DateTime?
  preferredTimeSlot String?
  attachments String[]             @default([])

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum ServiceRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum UrgencyLevel {
  LOW
  NORMAL
  URGENT
  EMERGENCY
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model MaintenanceSchedule {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title          String
  intervalMonths Int
  nextDueDate    DateTime
  status         ScheduleStatus @default(ACTIVE)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  currentJobId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([nextDueDate])
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Notification {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    String  @default("INFO")
  isRead  Boolean @default(false)
  linkUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId])
}

// ------------------------------------------------------
// AUDIT LOG
// ------------------------------------------------------

model AuditLog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String // e.g., "UPDATE_SETTINGS", "DELETE_QUOTE"
  entityType String // e.g., "TenantSettings", "Quote"
  entityId   String? // ID of the affected record
  details    Json? // Stores what changed (before/after)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// ------------------------------------------------------
// STAGE 23: INVENTORY & EXPENSES
// ------------------------------------------------------

model ProductCatalog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name  String
  sku   String?
  price Decimal?

  inventoryItems    InventoryItem[]
  equipmentRequests EquipmentRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum WarehouseType {
  HQ_WAREHOUSE
  VIRTUAL_TRUCK
}

model Warehouse {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  type WarehouseType @default(HQ_WAREHOUSE)

  assignedTechnicianId String? @unique
  assignedTechnician   User?   @relation(fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  inventoryItems    InventoryItem[]
  equipmentRequests EquipmentRequest[] // Requests sent to this warehouse

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model InventoryItem {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  productId String
  product   ProductCatalog @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productId])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

model EquipmentRequest {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  hqWarehouseId String
  hqWarehouse   Warehouse @relation(fields: [hqWarehouseId], references: [id], onDelete: Cascade)

  productId String
  product   ProductCatalog @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int

  status RequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum ExpenseStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model ExpenseReceipt {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  technicianId String
  technician   User   @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  amount          Decimal
  receiptPhotoUrl String

  status ExpenseStatus @default(PENDING_APPROVAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ------------------------------------------------------
// STAGE 24: ENTERPRISE PAYMENTS, FINANCIAL ESCROW & MILESTONES
// ------------------------------------------------------

enum BillingType {
  FIXED
  AUTH_AND_CAPTURE
  MILESTONE
}

enum PaymentGatewayType {
  STRIPE
  PAYSTACK
  FLUTTERWAVE
}

enum EscrowHoldStatus {
  HELD
  CAPTURED
  RELEASED
  FAILED
}

enum MilestoneStatus {
  PENDING
  INVOICED
  PAID
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

model QuoteMilestone {
  id       String @id @default(uuid())
  quoteId  String
  quote    Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title      String
  percentage Decimal
  amount     Decimal
  order      Int             @default(1)
  status     MilestoneStatus @default(PENDING)
  dueDate    DateTime?

  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([quoteId])
}

model EscrowHold {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  customerRecordId String
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  gateway        PaymentGatewayType @default(STRIPE)
  gatewayAuthId  String? // Stripe PaymentIntent ID or Paystack authorization token
  amount         Decimal
  currency       String             @default("USD")
  status         EscrowHoldStatus   @default(HELD)

  expiresAt      DateTime?
  capturedAt     DateTime?
  releasedAt     DateTime?
  failureReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([jobId])
  @@index([customerRecordId])
}

model PaymentTransaction {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerRecordId String?
  customerRecord   CustomerRecord? @relation(fields: [customerRecordId], references: [id], onDelete: SetNull)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  gateway              PaymentGatewayType
  transactionReference String             @unique
  gatewayReference     String?
  amount               Decimal
  currency             String             @default("USD")
  type                 String // "HOLD", "CAPTURE", "DIRECT_CHARGE", "MILESTONE_CHARGE", "REFUND"
  paymentMethod        String? // "CARD", "BANK_TRANSFER", "USSD"
  status               PaymentTransactionStatus @default(PENDING)
  metadata             Json?
  supportTickets       SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([transactionReference])
}

// ------------------------------------------------------
// STAGE 26: CUSTOMER SUPPORT HUB & DISPUTES
// ------------------------------------------------------

enum SupportTicketType {
  WARRANTY_CLAIM
  BILLING_DISPUTE
  SERVICE_COMPLAINT
  GENERAL_INQUIRY
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  ACTION_REQUIRED
  RESOLVED
  CLOSED
  REJECTED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DisputeReason {
  OVERCHARGED
  UNAUTHORIZED_FEE
  WORK_NOT_COMPLETED
  POOR_WORKMANSHIP
  DOUBLE_CHARGED
  WARRANTY_DENIAL
  OTHER
}

enum DisputeResolutionAction {
  UPHOLD_CHARGE
  PARTIAL_CREDIT
  FULL_REFUND
  VOID_INVOICE
}

enum MessageSenderType {
  CUSTOMER
  STAFF
  SYSTEM
}

model SupportTicket {
  id                   String              @id @default(uuid())
  ticketNumber         String              // Deterministic formatted: TKT-2026-00001
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerRecordId     String
  customerRecord       CustomerRecord      @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)

  type                 SupportTicketType   @default(GENERAL_INQUIRY)
  status               SupportTicketStatus @default(OPEN)
  priority             TicketPriority      @default(NORMAL)

  subject              String
  description          String
  attachments          String[]            @default([])

  // Contextual Entity Links
  assetId              String?
  asset                Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)

  invoiceId            String?
  invoice              Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  paymentTransactionId String?
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  jobId                String?
  job                  Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)

  // Warranty specific fields
  warrantyValidAtFiling Boolean?           @default(false)
  warrantyResolutionJobId String?

  // Dispute specific fields
  disputedAmount       Decimal?
  disputeReason        DisputeReason?
  resolutionAction     DisputeResolutionAction?
  refundTransactionId  String?

  // Assignment & Resolution lifecycle
  assignedStaffId      String?
  assignedStaff        User?               @relation("TicketAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  resolvedById         String?
  resolvedBy           User?               @relation("TicketResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes      String?
  firstResponseAt      DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?

  messages             SupportTicketMessage[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([tenantId, ticketNumber])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([customerRecordId])
  @@index([invoiceId])
  @@index([assetId])
}

model SupportTicketMessage {
  id               String            @id @default(uuid())
  ticketId         String
  ticket           SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderType       MessageSenderType @default(CUSTOMER)
  senderUserId     String?
  senderUser       User?             @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  senderName       String            // e.g. "Front Desk Staff", "John Doe (Customer)"
  message          String
  attachments      String[]          @default([])

  isInternalNote   Boolean           @default(false) // Staff-only internal note, never exposed to customer portal!
  readAt           DateTime?

  createdAt        DateTime          @default(now())

  @@index([ticketId, createdAt])
}

// ------------------------------------------------------
// STAGE 27: BLUE-COLLAR HR & SMS ONBOARDING
// ------------------------------------------------------

enum ProxyVerificationStatus {
  NOT_REQUIRED
  PENDING_HQ_REVIEW
  APPROVED
  REJECTED
}

enum HrDocumentType {
  NATIONAL_ID
  GOVERNMENT_PHOTO_ID
  TECH_LIVE_PHOTO
  TRADE_CERTIFICATION
  RESUME_CV
  CONTRACT_DISCLOSURE
  OTHER
}

model HrDocument {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId        String
  user          User           @relation("TechnicianHrFiles", fields: [userId], references: [id], onDelete: Cascade)

  documentType  HrDocumentType @default(GOVERNMENT_PHOTO_ID)
  fileName      String
  fileUrl       String
  fileSizeBytes Int?
  mimeType      String?
  notes         String?

  uploadedById  String
  uploadedBy    User           @relation("UploadedHrDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)

  verifiedAt    DateTime?
  verifiedById  String?
  verifiedBy    User?          @relation("VerifiedHrDocuments", fields: [verifiedById], references: [id], onDelete: SetNull)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([documentType])
}

// ------------------------------------------------------
// STAGE 28: FINTECH WALLETS & MULTI-TENANT PAYROLL
// ------------------------------------------------------

enum WalletType {
  HQ
  BRANCH
  STAFF
}

enum WalletStatus {
  ACTIVE
  FROZEN
  RESTRICTED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionCategory {
  JOB_SETTLEMENT
  ROYALTY_SPLIT
  COMMISSION_EARNED
  PAYOUT_REQUEST
  PAYOUT_SETTLED
  PAYOUT_REVERSED
  EXPENSE_REIMBURSEMENT
  MANUAL_ADJUSTMENT
}

enum PayoutStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  SUCCESSFUL
  REJECTED
  FAILED
}

model Wallet {
  id            String         @id @default(uuid())
  type          WalletType
  tenantId      String?
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId        String?        @unique
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  currency      String         @default("NGN")
  balance       Decimal        @default(0.00) @db.Decimal(14, 2)
  ledgerBalance Decimal        @default(0.00) @db.Decimal(14, 2)
  lockedBalance Decimal        @default(0.00) @db.Decimal(14, 2)
  status        WalletStatus   @default(ACTIVE)

  transactions  WalletTransaction[]
  payoutRequests PayoutRequest[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([tenantId, type], map: "unique_tenant_wallet_type")
  @@index([tenantId])
  @@index([status])
}

model WalletTransaction {
  id             String                    @id @default(uuid())
  walletId       String
  wallet         Wallet                    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type           WalletTransactionType
  category       WalletTransactionCategory
  amount         Decimal                   @db.Decimal(14, 2)
  balanceBefore  Decimal                   @db.Decimal(14, 2)
  balanceAfter   Decimal                   @db.Decimal(14, 2)

  reference      String                    @unique
  description    String

  jobId          String?
  job            Job?                      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  invoiceId      String?
  invoice        Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  payoutRequestId String?
  payoutRequest  PayoutRequest?            @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  metadata       Json?

  createdAt      DateTime                  @default(now())

  @@index([walletId, createdAt])
  @@index([reference])
  @@index([jobId])
  @@index([category])
}

model StaffBankDetail {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  bankName      String
  bankCode      String
  accountNumber String
  accountName   String
  recipientCode String?         // Paystack Transfer Recipient Code RCP_...
  isDefault     Boolean         @default(true)
  isVerified    Boolean         @default(true)

  payoutRequests PayoutRequest[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([userId, accountNumber, bankCode])
  @@index([userId])
  @@index([tenantId])
}

model PayoutRequest {
  id              String             @id @default(uuid())
  walletId        String
  wallet          Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)

  userId          String
  user            User               @relation("UserPayoutRequests", fields: [userId], references: [id], onDelete: Cascade)

  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  bankDetailId    String
  bankDetail      StaffBankDetail    @relation(fields: [bankDetailId], references: [id], onDelete: Restrict)

  amount          Decimal            @db.Decimal(14, 2)
  fee             Decimal            @default(0.00) @db.Decimal(10, 2)
  currency        String             @default("NGN")
  status          PayoutStatus       @default(PENDING_APPROVAL)

  reference       String             @unique
  transferCode    String?            // Paystack TRF_...

  reviewedById    String?
  reviewedBy      User?              @relation("ReviewedPayouts", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewNotes     String?            @db.Text
  rejectionReason String?            @db.Text
  failureReason   String?            @db.Text
  settledAt       DateTime?

  metadata        Json?

  walletTransactions WalletTransaction[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([tenantId, status])
  @@index([userId])
  @@index([walletId])
  @@index([reference])
}


